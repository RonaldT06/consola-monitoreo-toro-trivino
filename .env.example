# =====================================================================
#  Copia este archivo como .env y pon tus valores reales.
#  El archivo .env está en .gitignore: NUNCA se sube a GitHub.
# =====================================================================

# Bot de Telegram (lo da @BotFather) y chat(s) que reciben las alertas
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_IDS=123456789

# Communities SNMP configuradas en los equipos (lectura y traps)
SNMP_COMMUNITY=CambiaEstaCommunity
SNMP_TRAP_COMMUNITY=CambiaEstaTrapCommunity

# 1 = usar equipos simulados (pruebas sin hardware). 0 = equipos reales
NETMON_SIMULATE=0
